
#include <stdio.h>

int main()
{
    int start, end, i, temp, sum = 0;

    // Taking input from the user
    printf("Enter two numbers: ");
    scanf("%d %d", &start, &end);

    // Swapping numbers if entered in reverse order
    if (start > end)
    {
        temp = start;
        start = end;
        end = temp;
    }

    // Finding and adding odd numbers
    for (i = start; i <= end; i++)
    {
        if (i % 2 != 0)
        {
            sum = sum + i;
        }
    }

    // Displaying the result
    printf("Sum of odd numbers = %d\n", sum);

    return 0;
}
